SCHEDULERSE_IMAGE=ghcr.io/fixtse/schedulerse:latest
# Persistent volume for jobs, account and execution history.
SCHEDULERSE_STATE_VOLUME=schedulerse_state
# Optional host publishing overrides; omitting these keeps the defaults below.
# LISTEN_ADDR is fixed to :8789 inside the container by compose.yaml.
# Management is local-only by default. Use an SSH tunnel or HTTPS reverse proxy.
MANAGEMENT_BIND=127.0.0.1
MANAGEMENT_PORT=8789
# Set true when accessing the management UI via HTTPS.
COOKIE_SECURE=false
TZ=Europe/Madrid
# Default timeout; individual tasks can override this in the web interface.
REQUEST_TIMEOUT_MS=120000
# Add jobs, endpoints, authorization headers and schedules in the web interface.
# Configure Telegram notifications in the web interface.
